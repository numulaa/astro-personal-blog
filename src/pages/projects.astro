---
import Card from "@/components/Card.astro";
import { useTranslations } from "@/i18n";
import RootLayout from "@/layouts/RootLayout.astro";

const t = useTranslations();

const projectsData = [
{
    title: "Event Mama",
    description: `A platform for moms to create and join community-led classes—no more lost and buried WhatsApp messages, just clear, easy event sharing in one place.
`,
    imgSrc: "/images/event_mama.png",
    href: "https://event-kita.vercel.app/",
    tech: "Next.js, React, MongoDB, TailwindCSS, Stripe, Zod"
  },
{
    title: "Kindergarten School Management App (In Progress)",
    description: `A role-based app for teachers and parents to share daily student updates—like meals, naps, and moods—making communication simple, consistent, and stress-free.`,
    imgSrc: "/images/kindergarten_app.png",
    href: "#",
    tech: "Next.js, React, TailwindCSS, Zod, PostgreSQL, ReCharts, Docker, Prisma"
  },
  {
    title: "Quran of The Day",
    description: `To support a friend going through a tough time, I built "Quran of the Day"—a simple web app that shares random Quran verses for comfort and peace.`,
    imgSrc:
      "/images/quran-of-the-day.gif",
    href: "https://numulaa.github.io/Quran-of-The-Day/",
    tech: "HTML, CSS, JavaScript"

  },
  {
    title: "Shoplist",
    description: `A real-time shared grocery list app that helps families stay organized and avoid duplicate purchases—simple, fast, and built for daily efficiency.
`,
    imgSrc: "/images/Shoplist.png",
    href: "https://shoplist-live.netlify.app/",
    tech: "React, Firebase (Realtime DB), TailwindCSS"

  },
];
 
---

<RootLayout
  title={t("pages.projects.title")}
  description={t("pages.projects.description")}
>
  <div class="divide-y divide-gray-200 dark:divide-gray-700">
    <div class="space-y-2 pb-8 pt-6 md:space-y-5">
      <h1
        class="text-3xl font-extrabold leading-9 tracking-tight text-gray-900 dark:text-gray-100 sm:text-4xl sm:leading-10 md:text-6xl md:leading-14"
      >
        {t("pages.projects.allProjects")}
      </h1>
      <p class="text-lg leading-7 text-gray-500 dark:text-gray-400">
        {t("pages.projects.showcase")}
      </p>
    </div>
    <div class="container py-12">
      <div class="-m-4 flex flex-wrap">
        {
          projectsData.map((d) => (
            <Card
              title={d.title}
              description={d.description}
              imgSrc={d.imgSrc}
              href={d.href}
              tech={d.tech}
            />
          ))
        }
      </div>
    </div>
  </div>
</RootLayout>
